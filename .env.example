# Telegram (notificaciones al abrir/cerrar posición y resumen semanal)
# Crear bot con @BotFather, obtener chat_id con @userinfobot o getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bybit Futures Testnet (órdenes reales en sandbox)
# Crear keys en: https://testnet.bybit.com/ → API Management
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_SECRET=

# Bybit Futures Mainnet (órdenes reales con dinero real)
# Crear keys en: https://www.bybit.com/ → API Management
# IMPORTANTE: NO usar las mismas keys que testnet
BYBIT_API_KEY=
BYBIT_SECRET=

# Healthcheck externo (healthchecks.io — free tier, 20 checks)
# Crear check en https://healthchecks.io y pegar la URL de ping aquí.
# Si no hay ping en el período configurado, healthchecks.io envía alerta por email/Telegram.
# Dejar vacío para deshabilitar.
HEALTHCHECK_URL_LONG=
HEALTHCHECK_URL_SHORT=

# Backup remoto S3 (opcional) — usado por deploy/backup_state.sh
# Dejar vacío para solo hacer backup local
BACKUP_S3_BUCKET=

# Optional: stress mode (duplicate fees/slippage) - set in config YAML instead
# STRESS_MODE=false
